# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key - server-only, never exposed to the browser. Used by cron/API routes
# that need to write AI-generated snapshots outside a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# The only email allowed to sign in (single-user gate). Magic links to any other
# address are rejected by the app before Supabase even sends the email.
ALLOWED_USER_EMAIL=you@example.com

# Shared secret the GitHub Actions cron workflow sends as a header when it calls
# /api/cron/* routes, so those routes can't be triggered by anyone else.
CRON_SECRET=generate-a-long-random-string

# Your FPL team ID, e.g. from https://fantasy.premierleague.com/entry/1234567/event/1
# Optional here - can also be set from the onboarding page and stored in the DB.
FPL_TEAM_ID=

# Base URL of the deployed app, used by the cron workflow and for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
